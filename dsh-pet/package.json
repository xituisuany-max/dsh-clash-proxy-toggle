{
  "name": "@dsh-external/dsh-client-ui-pet",
  "description": "DSH web GUI 鲸鱼娘桌宠插件：可拖动吸附角落的 Q 版蓝发女仆鲸鱼娘，含 5 个动作（idle 待机 / happy 开心 / wave 挥手 / sleep 睡觉 / cry 哭哭）序列帧动画、点击蹦跳+台词气泡、双击切换动作。序列帧经本地 proxy-bridge /media/pet 通道提供。",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    }
  },
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ]
}